<Project Sdk="Microsoft.NET.Sdk">
	<!-- Generator snímok okien ElenFontEditora pre dokumentáciu (iniss-tools-docs).
	     Zostaví ukážkové súbory písiem ELEN, otvorí v nich okná programu a uloží ich
	     ako PNG vo svetlom aj tmavom režime. Spúšťa sa ručne, nie je súčasťou inštalácie. -->
	<PropertyGroup>
		<TargetFramework>net10.0-windows</TargetFramework>
		<!-- konzolová aplikácia, aby priebeh a varovania išli do terminálu; okná WinForms zobrazí aj tak -->
		<OutputType>Exe</OutputType>
		<UseWindowsForms>true</UseWindowsForms>
		<RootNamespace>ElenFontEditor.DocScreenshots</RootNamespace>
		<AssemblyName>ElenFontEditor.DocScreenshots</AssemblyName>
		<!-- titulky okien (Application.ProductName) ako v programe; konfigurácia a register
		     sa riadia názvom zostavy, takže ostávajú oddelené od ElenFontEditora -->
		<Product>ElenFontEditor</Product>
		<RuntimeIdentifier>win-x64</RuntimeIdentifier>
		<SelfContained>false</SelfContained>
		<AppendRuntimeIdentifierToOutputPath>false</AppendRuntimeIdentifierToOutputPath>
		<SatelliteResourceLanguages>cs</SatelliteResourceLanguages>
		<!-- LibraryImport pre PrintWindow/DWM generuje unsafe kód -->
		<AllowUnsafeBlocks>true</AllowUnsafeBlocks>
	</PropertyGroup>
	<ItemGroup>
		<ProjectReference Include="..\ElenFontEditor\ElenFontEditor.csproj" />
	</ItemGroup>
</Project>
