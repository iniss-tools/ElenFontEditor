<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<TargetFramework>net10.0-windows</TargetFramework>
		<OutputType>WinExe</OutputType>
		<RootNamespace>ElenFontEditor</RootNamespace>
		<AssemblyName>ElenFontEditor</AssemblyName>
		<UseWindowsForms>true</UseWindowsForms>
		<!-- verzia lokalnych zostav; vydanie ju prepise verziou zo znacky vX.Y (ToolsCore\Build\AppRelease.props) -->
		<Version>1.1</Version>
		<Copyright>Copyright © 2022</Copyright>
		<NeutralLanguage>sk</NeutralLanguage>
		<ApplicationIcon>fnt.ico</ApplicationIcon>
		<ApplicationManifest>app.manifest</ApplicationManifest>
		<LangVersion>default</LangVersion>
		<!-- Orezanie výstupu pre inštalátor - rovnako ako v GVDEditor.csproj.
		     Bez RID kopíruje SDK do runtimes\ aj natívne knižnice pre Android, Linux a macOS.
		     AppendRuntimeIdentifierToOutputPath=false: inak by výstup skončil v podpriečinku
		     win-x64 a rozbil cesty v ElenFontEditorInstaller.iss. -->
		<RuntimeIdentifier>win-x64</RuntimeIdentifier>
		<SelfContained>false</SelfContained>
		<AppendRuntimeIdentifierToOutputPath>false</AppendRuntimeIdentifierToOutputPath>
		<!-- Slovenčina je v hlavnej zostave, preložená je len čeština. -->
		<SatelliteResourceLanguages>cs</SatelliteResourceLanguages>
	</PropertyGroup>
	<ItemGroup>
		<Content Include="fnt.ico" />
		<!-- Licencie sú v koreni repozitára, spoločné pre celý projekt.
		     Link určuje, kam sa skopírujú vo výstupe - bez neho by skončili v jeho koreni. -->
		<Content Include="..\Licences\GPLv3.txt" Link="Licences\GPLv3.txt">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		</Content>
		<Content Include="..\Licences\LICENCE.txt" Link="Licences\LICENCE.txt">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		</Content>
	</ItemGroup>
	<ItemGroup>
		<ProjectReference Include="..\..\ExControls\ExControls\ExControls.csproj" />
		<ProjectReference Include="..\..\ToolsCore\ToolsCore\ToolsCore.csproj" />
	</ItemGroup>
	<!-- spolocne vlastnosti vydavanych programov: vyrobca, verzia a index aktualizacii z vydania -->
	<Import Project="..\..\ToolsCore\Build\AppRelease.props" />
</Project>
